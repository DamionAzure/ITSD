# A table that sorts itself

```python run id=sort
import json
a = [5, 2, 4, 1, 3]
def show(op, hl=None, **k):
    print("@itsd " + json.dumps({"op": op, "a": a, **({"hl": hl} if hl else {}), **k}))
show("start")
for end in range(len(a) - 1, 0, -1):
    for i in range(end):
        show("compare", [i, i + 1])
        if a[i] > a[i + 1]:
            a[i], a[i + 1] = a[i + 1], a[i]
            show("swap", [i, i + 1])
    show("pass", sorted=len(a) - end)
show("done", sorted=len(a))
```

