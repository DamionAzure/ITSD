{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ITSD",
  "version": "0.4.0",
  "identifier": "dev.itsd.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ITSD",
        "width": 1280,
        "height": 800,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "Damion Azure",
    "copyright": "Copyright © 2026 Damion Azure",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "itsd"
        ],
        "name": "Interactive Slide Deck",
        "description": "ITSD interactive slide deck",
        "mimeType": "text/x-itsd",
        "role": "Editor"
      }
    ],
    "resources": {
      "../example/": "example/",
      "../templates/": "templates/"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3RDJBOUMwRTMxQzAxMTEKUldRUkFSemp3S25TZHgyQ1dUQ0ViRGVKTFNHSWJPbVNHQTk2eUpWQjV2UWNOZ1ZFaXVzd2tXaWcK",
      "endpoints": [
        "https://itsd-updates-gamma.vercel.app/api/latest"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}