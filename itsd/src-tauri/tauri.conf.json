{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ITSD",
  "version": "0.1.0",
  "identifier": "dev.itsd.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ITSD",
        "width": 1280,
        "height": 800,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "itsd"
        ],
        "name": "Interactive Slide Deck",
        "description": "ITSD interactive slide deck",
        "mimeType": "text/x-itsd",
        "role": "Editor"
      }
    ]
  }
}